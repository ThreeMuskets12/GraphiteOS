diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index 1246ad6..28ce461 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -27,6 +27,7 @@
 
 #include <aidl/android/hardware/power/Boost.h>
 #include <android-base/logging.h>
+#include <android-base/parsedouble.h>
 #include <android-base/parseint.h>
 #include <android-base/properties.h>
 #include <android-base/stringprintf.h>
@@ -90,6 +91,7 @@
 #include <renderengine/impl/ExternalTexture.h>
 #include <scheduler/FrameTargeter.h>
 #include <statslog_surfaceflinger_bootstrap.h>
+#include <sys/system_properties.h>
 #include <sys/types.h>
 #include <ui/ColorSpace.h>
 #include <ui/DebugUtils.h>
@@ -419,6 +421,47 @@ nsecs_t sEinkLastSample = 0;
 nsecs_t sEinkPendingRepaint = 0;
 bool sEinkWasActive = false;
 
+// GraphiteOS: e-ink tuning, read whenever a system property changes (main thread only):
+//   adb shell setprop debug.eink.<name> <value>    e.g. debug.eink.dither 1.5
+//   adb shell setprop debug.eink.<name> ''         back to the default
+// Values reset on reboot. Invalid or out-of-range values are ignored.
+struct EinkSettings {
+    renderengine::EinkParams params;
+    float fps = 8;
+};
+
+const EinkSettings& einkSettings() {
+    static EinkSettings settings;
+    static std::optional<uint32_t> serial;
+    const uint32_t current = __system_property_area_serial();
+    if (serial == current) {
+        return settings;
+    }
+    serial = current;
+    settings = {};
+    auto& p = settings.params;
+    const struct {
+        const char* name;
+        float* value;
+        float min, max;
+    } tunables[] = {
+            {"tones", &p.tones, 2, 64},          {"rings", &p.rings, 0, 8},
+            {"hues", &p.hues, 1, 48},            {"saturation", &p.saturation, 0, 3},
+            {"warmth", &p.warmth, 0, 10},        {"dither", &p.dither, 0, 8},
+            {"cell", &p.cell, 1, 16},            {"black", &p.black, 0, 1},
+            {"white", &p.white, 0, 1},           {"fps", &settings.fps, 1, 240},
+    };
+    for (const auto& tunable : tunables) {
+        float value;
+        if (base::ParseFloat(base::GetProperty("debug.eink."s + tunable.name, ""), &value,
+                             tunable.min, tunable.max) &&
+            !std::isnan(value)) {
+            *tunable.value = value;
+        }
+    }
+    return settings;
+}
+
 // GraphiteOS: apps shown unfiltered whenever they are on screen (photo and camera apps).
 constexpr std::string_view kEinkBypassApps[] = {
         "com.google.android.apps.photos", "io.ente.photos", "io.ente.photos.fdroid",
@@ -3470,16 +3513,18 @@ CompositeResultsPerDisplay SurfaceFlinger::composite(
         }
     }
     if (refreshArgs.einkOutput) {
-        constexpr nsecs_t kEinkPeriod = 1'000'000'000 / 15;
+        const EinkSettings& settings = einkSettings();
+        refreshArgs.einkParams = settings.params;
+        const nsecs_t einkPeriod = static_cast<nsecs_t>(1e9f / settings.fps);
         const nsecs_t elapsed = presentTime - sEinkLastSample;
         refreshArgs.einkHold = sEinkWasActive &&
-                elapsed < kEinkPeriod - refreshArgs.frameInterval.getPeriodNsecs() / 2;
+                elapsed < einkPeriod - refreshArgs.frameInterval.getPeriodNsecs() / 2;
         if (!refreshArgs.einkHold) {
             sEinkLastSample = presentTime;
         } else if (sEinkPendingRepaint != sEinkLastSample) {
             // Make sure whatever changed during the hold is shown once the next frame is due.
             sEinkPendingRepaint = sEinkLastSample;
-            forceFutureUpdate(static_cast<int>(ns2ms(kEinkPeriod - elapsed)) + 1);
+            forceFutureUpdate(static_cast<int>(ns2ms(einkPeriod - elapsed)) + 1);
         }
     }
     sEinkWasActive = refreshArgs.einkOutput != nullptr;
