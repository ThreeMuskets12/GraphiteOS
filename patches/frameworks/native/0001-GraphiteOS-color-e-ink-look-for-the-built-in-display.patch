diff --git a/services/surfaceflinger/SurfaceFlinger.cpp b/services/surfaceflinger/SurfaceFlinger.cpp
index c957090..1246ad6 100644
--- a/services/surfaceflinger/SurfaceFlinger.cpp
+++ b/services/surfaceflinger/SurfaceFlinger.cpp
@@ -412,6 +412,63 @@ void invokeScreenCaptureError(const status_t status,
     captureListener->onScreenCaptureCompleted(captureResults);
 }
 
+// GraphiteOS: e-ink filter for the built-in display. Main thread only, except sEinkEnabled, which
+// is toggled with: adb shell service call SurfaceFlinger 1999 i32 <0|1>
+std::atomic<bool> sEinkEnabled = true;
+nsecs_t sEinkLastSample = 0;
+nsecs_t sEinkPendingRepaint = 0;
+bool sEinkWasActive = false;
+
+// GraphiteOS: apps shown unfiltered whenever they are on screen (photo and camera apps).
+constexpr std::string_view kEinkBypassApps[] = {
+        "com.google.android.apps.photos", "io.ente.photos", "io.ente.photos.fdroid",
+        "io.ente.photos.independent", "app.alextran.immich", "org.fossify.gallery",
+        "deckers.thibault.aves", "deckers.thibault.aves.libre", "com.amazon.clouddrive.photos",
+        "com.synology.projectkailash", "app.grapheneos.camera", "com.google.android.GoogleCamera",
+        "net.sourceforge.opencamera",
+};
+
+// GraphiteOS: apps shown unfiltered while they show video (a SurfaceView), e.g. in a video call.
+constexpr std::string_view kEinkVideoBypassApps[] = {
+        "com.whatsapp", "com.whatsapp.w4b", "org.thoughtcrime.securesms", "com.facebook.orca",
+        "com.google.android.apps.tachyon", "com.google.android.apps.meetings",
+        "us.zoom.videomeetings", "com.microsoft.teams", "org.telegram.messenger",
+        "com.viber.voip", "org.jitsi.meet", "com.cisco.wx2.android", "com.cisco.webex.meetings",
+        "com.discord", "com.Slack", "com.openbubbles.messaging",
+};
+
+// GraphiteOS: layer names look like "pkg/pkg.Activity#12" or "SurfaceView[pkg/pkg.Activity]#34".
+bool einkLayerIsFromApp(const std::string& name, std::string_view app) {
+    for (size_t i = name.find(app); i != std::string::npos; i = name.find(app, i + 1)) {
+        const size_t end = i + app.size();
+        if ((i == 0 || name[i - 1] == '[') && end < name.size() && name[end] == '/') {
+            return true;
+        }
+    }
+    return false;
+}
+
+// GraphiteOS: whether this visible layer turns the e-ink filter off for its display.
+bool einkBypassLayer(const frontend::LayerSnapshot& snapshot) {
+    if (snapshot.hasProtectedContent ||
+        (snapshot.buffer && (snapshot.buffer->getUsage() & GRALLOC_USAGE_HW_CAMERA_WRITE))) {
+        return true;
+    }
+    for (const auto app : kEinkBypassApps) {
+        if (einkLayerIsFromApp(snapshot.name, app)) {
+            return true;
+        }
+    }
+    if (snapshot.name.find("SurfaceView[") != std::string::npos) {
+        for (const auto app : kEinkVideoBypassApps) {
+            if (einkLayerIsFromApp(snapshot.name, app)) {
+                return true;
+            }
+        }
+    }
+    return false;
+}
+
 } // namespace
 
 // ---------------------------------------------------------------------------
@@ -3397,6 +3454,36 @@ CompositeResultsPerDisplay SurfaceFlinger::composite(
     }
     setupOutputsForReadback(refreshArgs.outputs);
 
+    // GraphiteOS: the built-in display gets the e-ink filter unless a bypass layer is visible on
+    // it. The output only shows a new frame every kEinkPeriod; frames in between repeat it.
+    for (const auto& [_, display] : displays) {
+        if (!display->isPrimary() || !sEinkEnabled) {
+            continue;
+        }
+        const ui::LayerStack layerStack = display->getLayerStack();
+        if (std::none_of(layers.begin(), layers.end(), [layerStack](const auto& layer) {
+                const auto& snapshot = *layer.second->mSnapshot;
+                return snapshot.isVisible && snapshot.outputFilter.layerStack == layerStack &&
+                        einkBypassLayer(snapshot);
+            })) {
+            refreshArgs.einkOutput = display->getCompositionDisplay().get();
+        }
+    }
+    if (refreshArgs.einkOutput) {
+        constexpr nsecs_t kEinkPeriod = 1'000'000'000 / 15;
+        const nsecs_t elapsed = presentTime - sEinkLastSample;
+        refreshArgs.einkHold = sEinkWasActive &&
+                elapsed < kEinkPeriod - refreshArgs.frameInterval.getPeriodNsecs() / 2;
+        if (!refreshArgs.einkHold) {
+            sEinkLastSample = presentTime;
+        } else if (sEinkPendingRepaint != sEinkLastSample) {
+            // Make sure whatever changed during the hold is shown once the next frame is due.
+            sEinkPendingRepaint = sEinkLastSample;
+            forceFutureUpdate(static_cast<int>(ns2ms(kEinkPeriod - elapsed)) + 1);
+        }
+    }
+    sEinkWasActive = refreshArgs.einkOutput != nullptr;
+
     std::vector<std::pair<Layer*, LayerFE*>> offloadedLayers;
     if (optionalOffloadedRefreshArgs) {
         offloadedLayers =
@@ -7507,6 +7594,9 @@ status_t SurfaceFlinger::CheckTransactCodeCredentials(uint32_t code) {
         code == IBinder::SYSPROPS_TRANSACTION) {
         return OK;
     }
+    if (code == 1999) { // GraphiteOS: e-ink toggle, caller is checked in onTransact
+        return OK;
+    }
     // Numbers from 1000 to 1047 are currently used for backdoors. The code
     // in onTransact verifies that the user is root, and has access to use SF.
     if (code >= 1000 && code <= 1047) {
@@ -7556,6 +7646,10 @@ status_t SurfaceFlinger::onTransact(uint32_t code, const Parcel& data, Parcel* r
             }
             case 1007: // Unused.
                 return NAME_NOT_FOUND;
+            case 1999: // GraphiteOS: e-ink filter on (1) or off (0).
+                sEinkEnabled = data.readInt32() != 0;
+                scheduleRepaint();
+                return NO_ERROR;
             case 1008: // Toggle forced GPU composition.
                 sfdo_forceClientComposition(data.readInt32() != 0);
                 return NO_ERROR;
