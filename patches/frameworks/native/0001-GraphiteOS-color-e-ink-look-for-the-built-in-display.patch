 }
+
+// GraphiteOS: color e-ink look. Works in OKLab: compresses tone between ink black and warm paper,
+// desaturates, and bins to 16 tones x 3 chroma rings x 12 hues (~300 colors) with a 2px ordered
+// dither. Tuned with tools/einkfilter.py; keep the two in sync.
+const SkString kEinkSkSL(R"(
+    uniform shader img;
+    float bayer2(float2 a) { a = floor(a); return fract(a.x / 2.0 + a.y * a.y * 0.75); }
+    float bayer8(float2 a) {
+        return (bayer2(0.25 * a) * 0.25 + bayer2(0.5 * a)) * 0.25 + bayer2(a);
+    }
+    float cuberoot(float x) { return sign(x) * pow(abs(x), 1.0 / 3.0); }
+    half4 main(float2 p) {
+        float3 c = float3(toLinearSrgb(img.eval(p).rgb));
+        float l = cuberoot(dot(float3(0.4122214708, 0.5363325363, 0.0514459929), c));
+        float m = cuberoot(dot(float3(0.2119034982, 0.6806995451, 0.1073969566), c));
+        float s = cuberoot(dot(float3(0.0883024619, 0.2817188376, 0.6299787005), c));
+        float L = 0.2104542553 * l + 0.7936177850 * m - 0.0040720468 * s;
+        float A = 1.9779984951 * l - 2.4285922050 * m + 0.4505937099 * s;
+        float B = 0.0259040371 * l + 0.7827717662 * m - 0.8086757660 * s;
+        float n = bayer8(floor(p / 2.0)) - 0.5 + 1.0 / 128.0;
+        float t = clamp(floor(clamp(L, 0.0, 1.0) * 15.0 + n + 0.5), 0.0, 15.0) / 15.0;
+        float chroma = length(float2(A, B));
+        float k = clamp(floor(clamp(chroma * 0.38 / 0.09, 0.0, 1.0) * 3.0 + n + 0.5), 0.0, 3.0) /
+                3.0 * 0.09;
+        // atan(0, 0) is undefined on GPUs, and the hue doesn't matter for greys anyway
+        float h = chroma > 1e-5 ? floor(atan(B, A) / 6.2831853 * 12.0 + 0.5) / 12.0 * 6.2831853
+                                : 0.0;
+        k *= min(1.0, 2.2 * min(t, 1.0 - t) + 0.25);
+        L = 0.32 + 0.60 * t;
+        A = k * cos(h) + 0.004 * t;
+        B = k * sin(h) + 0.020 * t;
+        l = L + 0.3963377774 * A + 0.2158037573 * B;
+        m = L - 0.1055613458 * A - 0.0638541728 * B;
+        s = L - 0.0894841775 * A - 1.2914855480 * B;
+        l = l * l * l;
+        m = m * m * m;
+        s = s * s * s;
+        c = float3(4.0767416621 * l - 3.3077115913 * m + 0.2309699292 * s,
+                   -1.2684380046 * l + 2.6097574011 * m - 0.3413193965 * s,
+                   -0.0041960863 * l - 0.7034186147 * m + 1.7076147010 * s);
+        return half4(fromLinearSrgb(half3(clamp(c, 0.0, 1.0))), 1.0);
+    }
+)");
+
+// GraphiteOS: shows the last filtered frame in dst.
+void drawEinkHeldFrame(const sk_sp<SkSurface>& dst, const sk_sp<SkSurface>& held) {
+    if (sk_sp<SkImage> image = held->makeImageSnapshot()) {
+        SkPaint paint;
+        paint.setBlendMode(SkBlendMode::kSrc);
+        dst->getCanvas()->drawImage(image, 0, 0, SkSamplingOptions(), &paint);
+    }
+}
+
+// GraphiteOS: copies the filtered version of dst into held, then shows held in dst.
+// Does nothing (dst stays unfiltered) if the shader or the offscreen surface is unavailable.
+void applyEinkFilter(const sk_sp<SkSurface>& dst, sk_sp<SkSurface>& held) {
+    static const sk_sp<SkRuntimeEffect> effect = [] {
+        auto [effect, error] = SkRuntimeEffect::MakeForShader(kEinkSkSL);
+        if (!effect) {
+            ALOGE("GraphiteOS: e-ink shader failed to compile: %s", error.c_str());
+        }
+        return effect;
+    }();
+    if (!effect) {
+        return;
+    }
+    if (!held || held->width() != dst->width() || held->height() != dst->height()) {
+        held = dst->makeSurface(dst->imageInfo());
+    }
+    sk_sp<SkImage> composed = dst->makeImageSnapshot();
+    if (!held || !composed) {
+        return;
+    }
+    SkRuntimeEffect::ChildPtr children[] = {composed->makeShader(SkSamplingOptions())};
+    SkPaint paint;
+    paint.setBlendMode(SkBlendMode::kSrc);
+    paint.setShader(effect->makeShader(SkData::MakeEmpty(), children));
+    held->getCanvas()->drawPaint(paint);
+    drawEinkHeldFrame(dst, held);
+}
 } // namespace
 
 // Helper class intended to be used on the stack to ensure that texture cleanup
@@ -936,6 +1016,16 @@ void SkiaRenderEngine::drawLayersInternal(
         return;
     }
 
+    // GraphiteOS: on e-ink hold frames, show the last filtered frame instead of the layers.
+    if (display.einkFilter && display.einkHold && !mInProtectedContext && mEinkSurface &&
+        mEinkSurface->width() == dstSurface->width() &&
+        mEinkSurface->height() == dstSurface->height()) {
+        drawEinkHeldFrame(dstSurface, mEinkSurface);
+        mCapture->endCapture();
+        resultPromise->set_value(sp<Fence>::make(flushAndSubmit(context, dstSurface)));
+        return;
+    }
+
     static const auto kDisplayColorTransformClamp =
             FlagManager::getInstance().color_transform_translation() ? SkColorFilters::Clamp::kNo
                                                                      : SkColorFilters::Clamp::kYes;
@@ -1633,6 +1723,10 @@ void SkiaRenderEngine::drawLayersInternal(
 
     LOG_THREAD_STATE_AND_CRASH_IF(activeSurface != dstSurface);
 
+    if (display.einkFilter && !mInProtectedContext) {
+        applyEinkFilter(dstSurface, mEinkSurface); // GraphiteOS
+    }
+
     auto drawFence = sp<Fence>::make(flushAndSubmit(context, dstSurface));
     trace(drawFence);
     FenceTimePtr fenceTime = FenceTime::makeValid(drawFence);
